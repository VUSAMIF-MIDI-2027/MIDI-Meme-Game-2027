{
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Memes": {
    "MaxCaptionLength": 100
  },
  "PhotoUpload": {
    "MaxFileSizeBytes": 10485760,
    "MaxRequestSizeBytes": 11534336,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ]
  },
  "Clerk": {
    "Authority": "",
    "SecretKey": "",
    "AuthorizedParties": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/Sqlite.db"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Security": "StartTls",
    "Username": "noreply@midi.lt",
    "Password": "",
    "FromAddress": "noreply@midi.lt",
    "FromName": "MIDI Notifications",
    "MaxAttempts": 8,
    "PollIntervalSeconds": 5
  },
  "Email": {
    "MaxSubjectLength": 200,
    "MaxBodyLength": 50000,
    "ScheduledPollIntervalSeconds": 30,
    "MaxMilestoneAgeHours": 24,
    "DefaultEventId": "default",
    "DeliveryBatchSize": 20,
    "StaleLeaseMinutes": 10
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/midiMemeGame.Api_.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{TraceIdentifier}] {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 2147483648,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 10
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "midiMemeGame.API"
    }
  },
  "AllowedHosts": "*"
}